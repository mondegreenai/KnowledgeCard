@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix energy: <https://mondegreen.ai/ontology/energy#> .

#################################################################
#  Mondegreen Energy Diagnostic Ontology (skeleton)
#
#  This is a SKELETON vocabulary, published to make the Knowledge
#  Card examples in this repository resolvable and self-contained.
#  It is intentionally minimal. It is NOT the full, layered domain
#  ontology used in Mondegreen engagements.
#
#  Copyright (c) 2026 Mondegreen.ai
#  Licensed under CC BY 4.0. Attribution: Mondegreen.ai.
#################################################################

energy: a owl:Ontology ;
    dcterms:title "Mondegreen Energy Diagnostic Ontology (skeleton)" ;
    dcterms:creator "Mondegreen.ai" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.2-skeleton" ;
    rdfs:comment "Skeleton diagnostic vocabulary for wind-energy drivetrain condition monitoring. Minimal by design." .

########################
#  Core diagnostic terms (reusable across domains)
########################

energy:FailureMode a owl:Class ;
    rdfs:label "Failure Mode" ;
    rdfs:comment "A characterised way in which a system or component fails." .

energy:Component a owl:Class ;
    rdfs:label "Component" .

energy:ObservableSignal a owl:Class ;
    rdfs:label "Observable Signal" ;
    rdfs:comment "A measurable quantity that carries evidence about a failure mode." .

energy:generates a owl:ObjectProperty ;
    rdfs:label "generates" ;
    rdfs:comment "Relates a degradation or failure mode to an observable signal it produces." ;
    rdfs:domain energy:Component ;
    rdfs:range energy:ObservableSignal .

########################
#  Energy domain terms
########################

energy:GearboxFailureMode a owl:Class ;
    rdfs:subClassOf energy:FailureMode ;
    rdfs:label "Gearbox Failure Mode" .

energy:GearboxBearing_OuterRaceSpalling a owl:Class ;
    rdfs:subClassOf energy:GearboxFailureMode ;
    rdfs:label "Outer-Race Spalling (High-Speed-Shaft Bearing)" ;
    rdfs:comment "Progressive spalling on the outer race of the high-speed-shaft bearing in a wind-turbine gearbox." .

energy:HSSBearing a owl:Class ;
    rdfs:subClassOf energy:Component ;
    rdfs:label "High-Speed-Shaft Bearing" .

energy:BearingOuterRace a owl:Class ;
    rdfs:subClassOf energy:Component ;
    rdfs:label "Bearing Outer Race" .

energy:BPFOAmplitude a owl:Class ;
    rdfs:subClassOf energy:ObservableSignal ;
    rdfs:label "BPFO Vibration Amplitude" ;
    rdfs:comment "Vibration amplitude at the bearing's ball-pass frequency, outer race." .

energy:FerrousParticleCount a owl:Class ;
    rdfs:subClassOf energy:ObservableSignal ;
    rdfs:label "Ferrous Particle Count" ;
    rdfs:comment "Count of ferrous particles in the gearbox lubricant." .

energy:OilTempTrend a owl:Class ;
    rdfs:subClassOf energy:ObservableSignal ;
    rdfs:label "Oil Temperature Trend" .

energy:GeneratorSpeed a owl:Class ;
    rdfs:subClassOf energy:ObservableSignal ;
    rdfs:label "Generator Speed" .
